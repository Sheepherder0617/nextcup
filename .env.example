# Copy this file to .env.local and fill in the values. .env.local is never committed.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# AI (server only) — console.groq.com → API Keys
GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# AI_DAILY_LIMIT=40

# Accounts + database — Supabase dashboard → Project Settings → API Keys / Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
